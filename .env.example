# Ключ OpenRouter — САМО в Environment Variables на Vercel, никога в клиента.
OPENROUTER_API_KEY=
# Модел за асистента. Приложението няма интерфейс за избор — задава се само тук.
# По подразбиране: anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=
# По желание: заглавия за класацията на OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
